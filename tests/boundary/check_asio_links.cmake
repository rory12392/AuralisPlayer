# 主程式、核心與模組的連結清單沒有 ASIO SDK 與 ASIO 外掛（T-103）。
# cmake -DLINKS_FILE=<設定時產生的清單> -P check_asio_links.cmake
# 清單每行「<目標>|<LINK_LIBRARIES>」；CONTROL 開頭的行是 ASIO 外掛的後端，要找得到 SDK（檢查本身有效）。
file(STRINGS "${LINKS_FILE}" _lines)
set(_pattern "asiosdk|asio_impl|plugin_asio")
set(_checked 0)
set(_control FALSE)
foreach(_line IN LISTS _lines)
    string(FIND "${_line}" "|" _bar)
    string(SUBSTRING "${_line}" 0 ${_bar} _target)
    math(EXPR _start "${_bar} + 1")
    string(SUBSTRING "${_line}" ${_start} -1 _links)
    if(_target MATCHES "^CONTROL ")
        if(NOT _links MATCHES "asiosdk")
            message(FATAL_ERROR "對照組 ${_target} 的連結清單沒有 asiosdk：檢查抓不到")
        endif()
        set(_control TRUE)
    elseif(_links MATCHES "${_pattern}")
        message(FATAL_ERROR "${_target} 連結了 ASIO（主程式不能含 ASIO SDK）：${_links}")
    else()
        math(EXPR _checked "${_checked} + 1")
    endif()
endforeach()
if(_checked EQUAL 0)
    message(FATAL_ERROR "清單是空的：${LINKS_FILE}")
endif()
message(STATUS "沒有 ASIO 的連結：${_checked} 個目標（對照組：${_control}）")
